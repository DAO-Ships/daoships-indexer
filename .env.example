# Quai Network
RPC_URL=https://rpc.orchard.quai.network
CHAIN_ID=15000

# Supabase Cloud
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_SCHEMA=dev

# Contract Addresses (Cyprus1 - Orchard Testnet)
DAOSHIP_LAUNCHER=0x00681160732b3141Ddb116F8B946aCf5fB4365fa
DAOSHIP_AND_VAULT_LAUNCHER=0x0056386fCE771Da46336DE77E8F046c30aBAF732
POSTER=0x0010CDE67Dc36f98557Fc686f800F908b755407C

# Indexer Configuration
POLL_INTERVAL_MS=5000
MAX_BLOCK_RANGE=100
CONFIRMATION_BLOCKS=3
START_BLOCK=0
LOG_LEVEL=info

# Reorg Detection
REORG_WALK_BACK=10

# Orphan Record Pruning (pre-DAO allowlist records)
ORPHAN_RETENTION_DAYS=90

# Health Check
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PORT=8080
HEALTH_MAX_BLOCKS_BEHIND=100
HEALTH_CHECK_TIMEOUT_MS=10000
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://testnet.daoships.quaidao.org,https://daoships.quaidao.org

# RPC Rate Limiting
RATE_LIMIT_REQUESTS=50
RATE_LIMIT_WINDOW_MS=1000

# Caching
TIMESTAMP_CACHE_SIZE=1000

# Retry Settings
RETRY_MAX_RETRIES=5
RETRY_BASE_DELAY_MS=1000
RETRY_MAX_DELAY_MS=60000
RETRY_ERROR_THRESHOLD=3

# Backfill (for standalone backfill script)
# BACKFILL_FROM=5513600
# BACKFILL_TO=
